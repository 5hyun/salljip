# 홈서버(192.168.0.10)의 ~/apps/housing-opportunity-lab/.env 템플릿.
# 이 파일은 rsync 대상이지만 실제 .env 는 동기화에서 제외되어 서버에만 존재한다.
POSTGRES_DB=housing_lab
POSTGRES_USER=housing_lab
POSTGRES_PASSWORD=change-me

RESTART_POLICY=unless-stopped
# 서버 3000 번은 nginx(manito) 사용 중
WEB_PORT=13000
API_PORT=18080
# 127.0.0.1 에만 바인딩
DB_PORT=15432

NEXT_PUBLIC_API_BASE_URL=http://192.168.0.10:18080
CORS_ALLOWED_ORIGINS=http://192.168.0.10:13000
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_MAP_PROVIDER=naver
SEOUL_OPEN_DATA_KEY=
HOUSING_LAB_DEMO_MODE=true

# 외부 API 사용량 관리자 페이지(/admin/usage) 접근 토큰. 비워 두면 관리자 기능이 꺼진다.
ADMIN_TOKEN=
# 일일 한도(0 = 미설정). 각 기관 마이페이지에서 확인한 값을 넣는다.
USAGE_LIMIT_MOLIT=0
USAGE_LIMIT_VWORLD=0
USAGE_LIMIT_SEOUL_OPEN_DATA=0
USAGE_LIMIT_NAVER_MAP=0
# 미니PC는 받는 쪽이라 USAGE_SYNC_URL 을 비워 둔다.
USAGE_SOURCE=minipc
