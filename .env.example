POSTGRES_DB=housing_lab
POSTGRES_USER=housing_lab
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://db:5432/housing_lab
DATABASE_USERNAME=housing_lab
DATABASE_PASSWORD=change-me
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-maps-client-id
# naver | none (none: 네이버 SDK를 불러오지 않아 개발·테스트에서 Dynamic Map 이용량을 쓰지 않음)
NEXT_PUBLIC_MAP_PROVIDER=naver
MOLIT_API_KEY=
OPENAI_API_KEY=

# 외부 API 사용량 관리자 페이지(/admin/usage) 접근 토큰. 비워 두면 관리자 기능이 꺼진다.
ADMIN_TOKEN=
# 일일 한도(0 = 미설정). 각 기관 마이페이지에서 확인한 값을 넣는다.
USAGE_LIMIT_MOLIT=0
USAGE_LIMIT_VWORLD=0
USAGE_LIMIT_SEOUL_OPEN_DATA=0
USAGE_LIMIT_NAVER_MAP=0
# Mac: 하루 1번(23:50) 사용량 누적값을 미니PC로 보낸다. 실패하면 다음 날 다시 보낸다.
USAGE_SOURCE=mac
USAGE_SYNC_URL=http://192.168.0.10:18080
# 미니PC의 ADMIN_TOKEN이 이 기기와 다를 때만 넣는다.
USAGE_SYNC_TOKEN=
USAGE_SYNC_CRON=0 50 23 * * *
